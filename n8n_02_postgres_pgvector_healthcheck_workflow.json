      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH expected(schema_name) AS (VALUES ('hr'), ('rag'), ('mail'), ('attendance'), ('audit')), found AS (SELECT s.schema_name FROM information_schema.schemata s JOIN expected e ON e.schema_name = s.schema_name), schema_info AS (SELECT COUNT(*)::int AS schema_count, COALESCE(string_agg(schema_name, ',' ORDER BY schema_name), '') AS schemas FROM found), vector_info AS (SELECT EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'vector') AS vector_present, COALESCE((SELECT extversion FROM pg_extension WHERE extname = 'vector'), '') AS pgvector_version) SELECT current_database() AS database, current_user AS db_user, version() AS postgres_version, vector_info.vector_present, vector_info.pgvector_version, schema_info.schemas, schema_info.schema_count, (current_database() = 'management_ai' AND current_user = 'management_admin' AND vector_info.vector_present AND schema_info.schema_count = 5) AS success, current_timestamp AS db_timestamp FROM schema_info CROSS JOIN vector_info;",
          "options": {}
        },
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          760,
