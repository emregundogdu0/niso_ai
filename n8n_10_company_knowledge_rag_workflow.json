  "name": "10_Company_Knowledge_RAG_Answer",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-subworkflow",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen3-embedding:0.6b\",\n  \"prompt\": {{ JSON.stringify($json.question || $json.query || '') }}\n}",
        "options": {}
      },
      "id": "generate-knowledge-embedding",
      "name": "Generate Query Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, content, 1 - (embedding <=> $1::vector) AS similarity FROM knowledge.company_doc_chunk ORDER BY embedding <=> $1::vector ASC LIMIT 3;",
        "options": {
          "queryReplacement": "={{ [\n  '[' + $json.embedding.join(',') + ']'\n] }}"
        }
      },
      "id": "fetch-knowledge-chunks",
      "name": "Retrieve Company Knowledge Chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        700,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgresManagementAi01",
          "name": "PostgreSQL Management AI"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen3.5:9b\",\n  \"prompt\": {{ JSON.stringify(\"Aşağıdaki kurumsal şirket dokümanını inceleyerek soruyu yanıtla:\\n\\n\" + ($input.all().map(i => i.json.content).join('\\n---\\n')) + \"\\n\\nSORU: \" + $('Execute Workflow Trigger').first().json.question + \"\\n\\nCEVAP:\") }},\n  \"stream\": false,\n  \"options\": {\n    \"temperature\": 0.1\n  }\n}",
        "options": {}
      },
      "id": "generate-knowledge-response",
      "name": "Qwen3.5-9B Answer Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        950,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "answer",
              "type": "stringValue",
              "stringValue": "={{ $json.response }}"
            },
            {
              "name": "route_used",
              "type": "stringValue",
              "stringValue": "COMPANY_KNOWLEDGE"
            },
            {
              "name": "timestamp",
              "type": "stringValue",
              "stringValue": "={{ $now.toISO() }}"
            }
          ]
        },
        "include": "none",
        "options": {}
      },
      "id": "format-knowledge-response",
      "name": "Format Knowledge Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        1200,
        300
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Generate Query Embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Query Embedding": {
      "main": [
        [
          {
            "node": "Retrieve Company Knowledge Chunks",
            "type": "main",
