{
  "name": "10_Company_Knowledge_RAG_Answer",
  "nodes": [
    {
      "parameters": {},
      "id": "start-node",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const question = $json.question || $json.normalized_question || '';\nconst sessionId = $json.session_id || 'knowledge_session';\nreturn [{ json: { question, session_id: sessionId } }];"
      },
      "id": "normalize-input",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "command": "node tools/company_knowledge_rag_engine.js \"{{ $json.question }}\""
      },
      "id": "execute-rag-engine",
      "name": "Execute Knowledge RAG Engine",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $json.stdout || '';\nlet answer = 'Kurumsal bilgi tabanında bilgi bulunamadı.';\nlet sources = [];\n\nconst answerMatch = rawOutput.match(/--- ANSWER ---\\s*([\\s\\S]*)$/);\nif (answerMatch) {\n  answer = answerMatch[1].trim();\n}\n\nconst sourcesMatch = rawOutput.match(/--- SOURCES ---\\s*(.*)/);\nif (sourcesMatch) {\n  sources = sourcesMatch[1].split(',').map(s => s.trim());\n}\n\nreturn [{\n  json: {\n    answer,\n    sources,\n    raw_stdout: rawOutput\n  }\n}];"
      },
      "id": "format-response",
      "name": "Format Knowledge Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Execute Knowledge RAG Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Knowledge RAG Engine": {
      "main": [
        [
          {
            "node": "Format Knowledge Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
