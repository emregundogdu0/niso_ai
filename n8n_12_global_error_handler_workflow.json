  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const errData = $input.first().json;\n\nconst errMessage = errData.execution?.error?.message || errData.message || 'Bilinmeyen sistem hatası';\nconst nodeName = errData.execution?.lastNodeExecuted || 'Genel';\n\nlet errorCategory = 'INTERNAL_ERROR';\nlet userMessage = 'İşleminiz gerçekleştirilirken bir sistem hatası oluştu. Lütfen tekrar deneyin.';\nlet severity = 'ERROR';\n\nconst errLower = errMessage.toLowerCase();\nif (errLower.includes('ollama') || errLower.includes('econnrefused') || errLower.includes('11434')) {\n  errorCategory = 'OLLAMA_UNAVAILABLE';\n  userMessage = 'Yapay zeka modeli şu anda yanıt vermiyor. Sistem yöneticisiyle iletişime geçiniz.';\n  severity = 'CRITICAL';\n} else if (errLower.includes('postgres') || errLower.includes('5432') || errLower.includes('timeout')) {\n  errorCategory = 'POSTGRES_CONNECTION_ERROR';\n  userMessage = 'Veritabanı bağlantısında geçici bir gecikme yaşandı. Lütfen biraz sonra tekrar deneyiniz.';\n  severity = 'HIGH';\n} else if (errLower.includes('guard') || errLower.includes('blocked') || errLower.includes('security')) {\n  errorCategory = 'SQL_GUARD_REJECTION';\n  userMessage = 'Güvenlik ilkeleri gereği bu istek reddedilmiştir.';\n  severity = 'WARNING';\n}\n\nreturn [{\n  json: {\n    error_category: errorCategory,\n    severity: severity,\n    node_name: nodeName,\n    user_message: userMessage,\n    internal_error: errMessage,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "categorize-error",
      "name": "Categorize & Sanitize Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit.security_event (\n  event_id, event_type, severity, route, description, action_taken, created_at\n) VALUES (\n  gen_random_uuid(), $1, $2, $3, $4, 'BLOCKED_AND_USER_NOTIFIED', now()\n)\nRETURNING event_id;",
        "options": {
          "queryReplacement": "={{ [\n  $json.error_category,\n  $json.severity,\n  $json.node_name,\n  $json.internal_error\n] }}"
        }
      },
      "id": "audit-security-event",
      "name": "Audit Security Event in Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        700,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgresManagementAi01",
          "name": "PostgreSQL Management AI"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "success",
              "type": "booleanValue",
              "booleanValue": false
            },
            {
              "name": "error_category",
